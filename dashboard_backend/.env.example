# Example .env file for dashboard_backend (FastAPI)

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=dashboard_db

# Auth/JWT configuration
JWT_SECRET=your-production-jwt-secret
JWT_ALGORITHM=HS256

# SMTP email configuration (required for report scheduling)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=dashboard-noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=dashboard-noreply@example.com
