# MongoDB settings
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=dashboard_db

# JWT/Reset Token secrets
SECRET_KEY=REPLACE_THIS_SECRET        # used for main JWT login
RESET_TOKEN_SECRET=REPLACE_THIS_SECRET_2 # used for password reset
RESET_TOKEN_EXPIRY_MINUTES=30

# Base site URL for reset links
SITE_URL=https://dashboard.tataelxsi.co.in

# SMTP configuration
SMTP_HOST=smtp.yourserver.com
SMTP_PORT=587
SMTP_USER=smtpuser
SMTP_PASS=smtppassword
SMTP_FROM=dashboard-noreply@tataelxsi.co.in
